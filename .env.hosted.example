# Optional hosted preview. Copy to .env.hosted at the repository root.
# Your existing apps/server/.env and apps/web/.env stay separate.
PUBLIC_APP_URL=http://localhost:3002
PORT=3002
DATABASE_URL=YOUR_TIGER_DATA_CONNECTION_STRING
AUTH0_ISSUER_BASE_URL=https://dev-3daqegbds3uctd8l.us.auth0.com
AUTH0_AUDIENCE=https://sword-api
VITE_AUTH0_DOMAIN=dev-3daqegbds3uctd8l.us.auth0.com
VITE_AUTH0_CLIENT_ID=M5zNcKJOswrwafsCXpkJwAtwesX0mSq5
VITE_AUTH0_AUDIENCE=https://sword-api

# Leave disabled until the hosted backend has its own Google identity.
# Local gcloud credentials are not transferred to Render. See docs/gemini-setup.md.
GEMINI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_REQUEST_LIMIT=500

# ElevenLabs uses its own API key; it does not require Google ADC.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_DAILY_CHARACTER_LIMIT=10000
