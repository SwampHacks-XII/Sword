# Copy this file to .env in apps/server. Leave values blank until services exist.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Auth0 tenant URL, e.g. https://dev-YOUR-TENANT.us.auth0.com/
AUTH0_ISSUER_BASE_URL=
# Identifier of the custom Auth0 API, e.g. https://sword-api
AUTH0_AUDIENCE=

# Tiger Data PostgreSQL connection string. Keep it private and URL-encode passwords.
# Example shape: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=verify-full
# Tiger Cloud hostnames automatically use certs/tiger-ca.pem unless sslrootcert is set.
# The included public CA pin is for this project's Tiger Cloud service.
# See certs/README.md before using it for a different service or replacing it.
DATABASE_URL=

# Optional Gemini quests through Google Cloud Agent Platform / Vertex AI.
# Credentials stay on the backend: run gcloud auth application-default login locally.
# Never put Google credentials in apps/web or VITE_ variables.
GEMINI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
# Per backend process, per UTC day. Not a Google billing/spending cap.
GEMINI_DAILY_REQUEST_LIMIT=500
# Render can use the optional Cloud Run helper instead of local Google credentials.
# See docs/gemini-render.md. These two values are backend-only.
GEMINI_RELAY_URL=
GEMINI_RELAY_TOKEN=

# Optional ElevenLabs main voice. Browser speech automatically backs it up.
# Get a Text to Speech API key at https://elevenlabs.io/app/developers/api-keys
# Keep this key on the backend; never create a VITE_ELEVENLABS_API_KEY variable.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# New generated characters per UTC day, per backend process; not a billing cap.
ELEVENLABS_DAILY_CHARACTER_LIMIT=10000
