# Copy to apps/web/.env. These browser settings are public.
# Keep database URLs, client secrets, and API keys in the server only.
VITE_API_BASE_URL=http://localhost:3001
VITE_AUTH0_DOMAIN=YOUR-TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_SWORD_WEB_SPA_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://sword-api

# Swamp Bot works without Auth0 or a backend; blank Auth0 values disable online login.
# Choose online or Swamp Bot from the menu. VITE_CONNECTION is no longer used.
