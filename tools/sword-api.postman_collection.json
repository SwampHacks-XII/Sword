    {
      "name": "00 — Health",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "Public server status. This does not check database connectivity."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeded', () => pm.expect(pm.response.code).to.be.within(200, 299));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 — A: Save profile",
      "request": {
        "method": "PUT",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/me",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"Player A\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Requires player A's Auth0 access token. See docs/game-data-api.md for instructions."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeded', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set('playerAId', data.player.id);",
              "}"
            ]
          }
        }
      ]
    },
