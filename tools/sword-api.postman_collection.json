{
  "info": {
    "name": "Sword — Two-player backend walkthrough",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests in order. Set tokenA and tokenB to two different players' Auth0 access tokens for Sword API. Keep tokens private; do not export or commit populated secrets. IDs and the join code are saved automatically from responses. Each complete walkthrough creates a new session and two new sample sword registrations. This tests storage/session management; it does not implement hardware connections or combat rules. Full instructions: docs/game-data-api.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "tokenA",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenB",
      "value": "",
      "type": "string"
    },
    {
      "key": "playerAId",
      "value": "",
      "type": "string"
    },
    {
      "key": "playerBId",
      "value": "",
      "type": "string"
    },
    {
      "key": "swordAId",
      "value": "",
      "type": "string"
    },
    {
      "key": "swordBId",
      "value": "",
      "type": "string"
    },
    {
      "key": "matchId",
      "value": "",
      "type": "string"
    },
    {
      "key": "joinCode",
      "value": "",
      "type": "string"
